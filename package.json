{
  "name": "@siampiwat/spgrid",
  "version": "2.0.9",
  "description": "Reusable vanilla JS SPGrid",
  "homepage": "https://github.com/banpotej/siampiwat-datagrid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banpotej/siampiwat-datagrid.git"
  },
  "bugs": {
    "url": "https://github.com/banpotej/siampiwat-datagrid/issues"
  },
  "type": "module",
  "main": "./dist/spgrid.styled.cjs",
  "module": "./dist/spgrid.styled.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/spgrid.styled.js",
      "require": "./dist/spgrid.styled.cjs"
    },
    "./plain": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/spgrid.js",
      "require": "./dist/spgrid.cjs"
    },
    "./style.css": "./dist/spgrid.css",
    "./agent-guide": "./docs/AGENT_GUIDE.md"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/AGENT_GUIDE.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css",
    "./dist/spgrid.styled.js",
    "./dist/spgrid.styled.cjs"
  ],
  "scripts": {
    "dev": "vite --open /",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "npm run build && vite build -c vite.site.config.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "pack:release": "powershell -NoProfile -ExecutionPolicy Bypass -File pack.ps1",
    "pack:site": "powershell -NoProfile -ExecutionPolicy Bypass -File pack-site.ps1",
    "deploy:site": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy-site.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "jsdelivr": "dist/spgrid.js",
  "unpkg": "dist/spgrid.js",
  "publishConfig": {
    "access": "public"
  }
}
